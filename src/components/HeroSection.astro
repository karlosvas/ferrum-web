---
import GradientButton from "./GradientButton.astro";

// TODO: Resicze in canvas
---

<section
  class="relative m-auto flex min-h-screen items-center justify-center pt-28 pb-12 align-middle"
>
  <div
    class="z-10 flex w-full flex-col items-center justify-center gap-8 md:gap-10 lg:flex-row"
  >
    <div class="flex w-full flex-1 flex-col">
      <h1
        class="text-primary-light font-mono text-3xl font-bold sm:text-4xl lg:text-5xl xl:text-6xl"
      >
        Imaginación en Tres Dimensiones
      </h1>
      <p
        class="text-muted pt-5 text-sm leading-relaxed sm:text-base lg:text-lg"
      >
        Explora tu imaginación mediante un motor dedicado a replicación de la
        realidad utilizando un motor 3D con todas las funcionalidades para crear
        experiencias inmersivas tanto en el ambito de RV como videojuegos con
        una gran eficiencia, todo integrado en un único entorno 3D interactivo.
        Ferrum te da las herramientas para crear, un mundo, el mundo que tu
        elijas .
      </p>
      <div
        class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold sm:text-base"
      >
        <div class="border-line border-r pr-4">100+ Shaders</div>
        <div class="border-line border-r pr-4">3D VR Nativo</div>
        <div>Multi Plataforma</div>
      </div>

      <GradientButton url="/download" glow={false}
        >Apoyar el proyecto</GradientButton
      >
    </div>

    <canvas
      id="model-canvas"
      class="aspect-square w-full max-w-md rounded-xl sm:max-w-lg lg:w-1/2 lg:max-w-none"
    >
    </canvas>
  </div>
</section>

<script>
  import emisiveRetro from "@/shaders/emisive_retro.glsl";
  import noise from "@/shaders/noise.glsl";
  document.addEventListener("astro:page-load", () => {
    const canvas = document.getElementById(
      "model-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    // Al navegar con ClientRouter el canvas se descarta: paramos el bucle de render.
    let alive = true;

    const observer = new IntersectionObserver(
      async (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          const [
            {
              Scene,
              PerspectiveCamera,
              WebGLRenderer,
              Box3,
              Vector2,
              Vector3,
              SRGBColorSpace,
              Mesh,
              ACESFilmicToneMapping,
              Timer,
            },
            { GLTFLoader },
            { DRACOLoader },
            { OrbitControls },
            { EffectComposer },
            { RenderPass },
            { UnrealBloomPass },
            { OutputPass },
          ] = await Promise.all([
            import("three"),
            import("three/examples/jsm/loaders/GLTFLoader.js"),
            import("three/examples/jsm/loaders/DRACOLoader.js"),
            import("three/examples/jsm/controls/OrbitControls.js"),
            import("three/examples/jsm/postprocessing/EffectComposer.js"),
            import("three/examples/jsm/postprocessing/RenderPass.js"),
            import("three/examples/jsm/postprocessing/UnrealBloomPass.js"),
            import("three/examples/jsm/postprocessing/OutputPass.js"),
          ]);
          const dracoLoader = new DRACOLoader();
          dracoLoader.setDecoderPath(
            "https://www.gstatic.com/draco/v1/decoders/",
          );
          const loader = new GLTFLoader();

          loader.setDRACOLoader(dracoLoader);
          const scene = new Scene();
          const ambientLight = new (await import("three")).AmbientLight(
            0xffffff,
            1,
          );
          const directionalLight = new (await import("three")).DirectionalLight(
            0xffffff,
            2,
          );
          directionalLight.position.set(5, 5, 5);
          const camera = new PerspectiveCamera(
            50,
            canvas.clientWidth / canvas.clientHeight,
            0.1,
            1000,
          );
          const renderer = new WebGLRenderer({
            canvas,
            antialias: true,
            alpha: true,
          });
          renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
          renderer.setClearColor(0x000000, 0);
          renderer.outputColorSpace = SRGBColorSpace;
          renderer.toneMapping = ACESFilmicToneMapping;
          renderer.toneMappingExposure = 1.0;

          let screenMaterial: any;

          loader.load("/models/tv.glb", (gltf) => {
            scene.add(ambientLight);
            scene.add(directionalLight);
            scene.add(gltf.scene);

            const crtUniforms = { uTime: { value: 0 } };

            gltf.scene.traverse((child: any) => {
              if (
                child instanceof Mesh &&
                child.material.name === "Material.002"
              ) {
                screenMaterial = child.material;
                screenMaterial.metalness = 0;
                screenMaterial.roughness = 1;
                screenMaterial.envMapIntensity = 0;
                screenMaterial.onBeforeCompile = (shader: any) => {
                  shader.uniforms.uTime = crtUniforms.uTime;

                  shader.fragmentShader = shader.fragmentShader.replace(
                    "#include <common>",
                    noise,
                  );

                  shader.fragmentShader = shader.fragmentShader.replace(
                    "#include <emissivemap_fragment>",
                    emisiveRetro,
                  );
                };
                screenMaterial.needsUpdate = true;
              }
            });

            const box = new Box3().setFromObject(gltf.scene);
            const center = box.getCenter(new Vector3());
            const size = box.getSize(new Vector3());
            const maxDim = Math.max(size.x, size.y, size.z);
            camera.position.set(center.x, center.y, center.z + maxDim);
            const controls = new OrbitControls(camera, renderer.domElement);
            controls.target.copy(center);
            controls.enableDamping = true;
            controls.enableZoom = false;
            controls.dampingFactor = 0.05;
            controls.minDistance = maxDim * 1.7;
            controls.maxDistance = maxDim * 3;
            controls.update();

            const composer = new EffectComposer(renderer);
            composer.addPass(new RenderPass(scene, camera));
            composer.addPass(
              new UnrealBloomPass(
                new Vector2(canvas.clientWidth, canvas.clientHeight),
                1.0,
                0.6,
                0.9,
              ),
            );
            composer.addPass(new OutputPass());

            const resize = () => {
              const w = canvas.clientWidth;
              const h = canvas.clientHeight;
              if (!w || !h) return;
              renderer.setSize(w, h, false);
              composer.setSize(w, h);
              camera.aspect = w / h;
              camera.updateProjectionMatrix();
            };
            new ResizeObserver(resize).observe(canvas);

            const clock = new Timer();

            document.addEventListener(
              "astro:before-swap",
              () => {
                alive = false;
                renderer.dispose();
              },
              { once: true },
            );

            function animate() {
              if (!alive) return;
              requestAnimationFrame(animate);
              clock.update();

              const t = clock.getElapsed();
              crtUniforms.uTime.value = t;

              if (screenMaterial) {
                screenMaterial.emissiveIntensity = 3 + Math.sin(t * 12) * 0.2;
              }

              controls.update();
              composer.render();
            }
            animate();
          });
        }
      },
      { rootMargin: "200px" },
    );
    observer.observe(canvas);
  });
</script>
