<section class="relative my-20 md:my-32" id="vr">
  <div class="mb-12">
    <h2 class="mb-4 text-2xl font-bold md:text-3xl">
      Inmersión en Realidad Virtual
    </h2>
    <p class="text-muted max-w-2xl text-base md:text-lg">
      Explora el mundo vegetal en un espacio tridimensional completo. <br /> Cada
      detalle de la planta cobra vida ante tus ojos.
    </p>
  </div>

  <div class="mb-6 flex flex-col gap-5 lg:flex-row">
    <video
      class="h-fit w-full rounded-2xl shadow-2xl lg:w-1/2"
      id="hero-video"
      src="/movimiento.mp4"
      autoplay
      muted
      playsinline
      loop></video>

    <div
      class="group relative flex overflow-hidden rounded-2xl shadow-2xl lg:w-1/2"
    >
      <img
        src="/img/gafas.webp"
        alt="Gafas VR"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <div
        class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-100 transition-opacity duration-300 lg:opacity-0 lg:group-hover:opacity-100"
      >
        <div class="absolute bottom-4 left-4 text-white">
          <p class="text-xl font-semibold">Soporte OpenXR</p>
          <p>Meta Quest Pro</p>
        </div>
      </div>
    </div>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    <div
      class="hover:border-primary-light/50 border-line bg-secondary rounded-xl border p-6 transition-colors"
    >
      <h4 class="mb-2 text-lg font-bold">Controles Intuitivos</h4>
      <p class="text-sm opacity-80">
        Manipula y rota modelos vegetales con tus manos en el espacio virtual
      </p>
    </div>
    <div
      class="hover:border-primary-light/50 border-line bg-secondary rounded-xl border p-6 transition-colors"
    >
      <h4 class="mb-2 text-lg font-bold">Precisión científica</h4>
      <p class="text-sm opacity-80">
        Visualiza estructuras botánicas con fidelidad científica en escala real
      </p>
    </div>
    <div
      class="hover:border-primary-light/50 border-line bg-secondary rounded-xl border p-6 transition-colors"
    >
      <h4 class="mb-2 text-lg font-bold">60 FPS Estables</h4>
      <p class="text-sm opacity-80">
        Experiencia fluida optimizada para dispositivos VR de última generación.
      </p>
    </div>
  </div>
</section>
