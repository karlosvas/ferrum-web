---
interface Props {
  dataSection: Array<Record<string, any>>;
}
const { dataSection } = Astro.props;
---

<section class="my-20 md:my-40" id="features">
  <h2 class="text-primary-light mb-6 text-2xl font-bold md:text-3xl">
    Características
  </h2>
  <div class="my-5 grid grid-cols-1 gap-6 md:grid-cols-2">
    {
      dataSection.map((item) => {
        return (
          <div class="bg-secondary border-line hover:border-primary group space-y-3 rounded-xl border p-5 transition duration-200 hover:translate-y-0.5">
            <span class="flex items-start gap-3">
              <item.svg
                height="30px"
                width="40px"
                class="group-hover:text-primary"
              />
              <h3 class="group-hover:text-primary-light font-semibold">
                {item.title}
              </h3>
            </span>
            <p class="text-muted group-hover:text-light transition-colors duration-200">
              {item.description}
            </p>
          </div>
        );
      })
    }
  </div>
</section>
